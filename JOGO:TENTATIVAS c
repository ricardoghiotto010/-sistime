#include <stdio.h>
#include <stdlib.h>
#include <time.h>

int avaliar_palpite(int palpite, int secreto) {
    if (palpite < secreto) {
        printf("Muito baixo! Tente novamente.\n\n");
        return 0;
    } else if (palpite > secreto) {
        printf("Muito alto! Tente novamente.\n\n");
        return 0;
    } else {
        printf("Parabens! Voce acertou o numero %d!\n", secreto);
        return 1;
    }
}

int main() {
    srand(time(NULL)); 

    int numero_secreto = (rand() % 100) + 1; 
    char entrada[50]; 
    int palpite = 0;
    int acertou = 0;
    int tentativas = 0;

    printf("Tente adivinhar o numero secreto entre 1 e 100!\n");

    while (!acertou) {
        printf("Digite seu palpite: ");
        
        fgets(entrada, sizeof(entrada), stdin);
        palpite = atoi(entrada); 
        tentativas++;

        acertou = avaliar_palpite(palpite, numero_secreto);
    }

    printf("Voce precisou de %d tentativas.\n", tentativas);

    return 0;
}
